# 이 파일을 application-local.yml 로 복사한 뒤 값을 채우세요. (복사본은 커밋 금지)
spring:
  datasource:
    username: tanoshimi
    password: 여기에_로컬_DB_비밀번호
  security:
    oauth2:
      client:
        registration:
          google:
            client-id: 구글_클라이언트_ID
            client-secret: 구글_시크릿
          naver:
            client-id: 네이버_클라이언트_ID
            client-secret: 네이버_시크릿
          line:
            client-id: 라인_채널_ID
            client-secret: 라인_채널_시크릿

app:
  sms:
    provider: log
    aligo:
      api-key: 알리고_API_KEY
      user-id: 알리고_아이디
      sender: 01000000000
  weather:
    provider: mock     # 실제 키 생기면 kma 또는 openweather 로 변경
    api-key: 날씨_API_KEY
  translation:
    provider: mock      # 실제 키 생기면 papago 또는 deepl 로 변경
    api-key: 번역_API_KEY
  companion:
    provider: gemini    # 실제 AI 연동 시: anthropic 또는 gemini
    api-key: Gemini_API_KEY
